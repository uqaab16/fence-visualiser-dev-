# Optional: overrides the default portal password ("Uassistant" if unset)
VITE_APP_PASSWORD=

# Optional: enables the live Google Maps satellite measuring tool.
# If unset, the app falls back to a built-in mock/sandbox map.
VITE_GOOGLE_MAPS_API_KEY=

# PostHog analytics (Product Analytics, Session Replay, Web Analytics).
# Public client-side key — safe to commit. Leave blank to disable tracking.
VITE_POSTHOG_KEY=
